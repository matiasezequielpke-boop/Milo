# --- Model providers (leave empty until there's budget — Fase 0) ---
# ANTHROPIC_API_KEY turns on the live Milo/Warden agent in chat. Without
# it the chat says so — it never answers with scripted text.
ANTHROPIC_API_KEY=
# WARDEN_MODEL=claude-opus-5-5
# WARDEN_EFFORT=medium
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Warden: bank data (Plaid, read-only) ---
# Free sandbox keys at dashboard.plaid.com. sandbox = Plaid's test banks.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=

# --- Warden: payments (Stripe) ---
# Use an sk_test_ key. Live keys are refused unless PAYMENTS_LIVE_ENABLED
# is explicitly set after legal review — see docs/money-plan.md.
STRIPE_SECRET_KEY=
# STRIPE_TEST_PAYMENT_METHOD=pm_card_visa
PAYMENTS_LIVE_ENABLED=false

# --- Warden: email (approval requests, invites, alerts) ---
# Without it, invites return a link to share by hand.
RESEND_API_KEY=
EMAIL_FROM=Warden <warden@example.com>
WEB_APP_URL=http://localhost:3000

# Local only: accept `Authorization: Bearer dev:<email>` so the family
# flow can run without Supabase. Refused outside APP_ENV=development.
DEV_AUTH_ENABLED=false

# No sign-in (for now): the API serves a ready-made demo family and accepts
# `Bearer demo:<email>` for those two people only. Refuses to start with
# PAYMENTS_LIVE_ENABLED, an sk_live_/rk_live_ Stripe key, or Plaid production.
DEMO_MODE=false
DEMO_OWNER_EMAIL=rosa@demo.warden.app
DEMO_APPROVER_EMAIL=ana@demo.warden.app

# --- Tool providers (Fase 2/3 — same "leave empty until funded" rule) ---
TAVILY_API_KEY=
E2B_API_KEY=

# --- Database ---
# Local/docker-compose Postgres by default. For production, point this at
# Supabase's connection pooler instead — Project Settings -> Database ->
# Connection string -> "Transaction" pooler in the Supabase dashboard.
# The password there is the one set when the project was created (or reset
# from that same page) — it isn't retrievable any other way, including via
# the Supabase MCP tools, so this has to be filled in by hand:
#   postgresql://postgres.ptjwcliszbfpknyryzft:[DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://milo:milo@localhost:5432/milo

# --- Supabase Auth (identity — see claude/ruta-a-produccion.md) ---
# Both required for login to work at all; without them every authenticated
# endpoint returns 503, not 401 (see app/deps.py) so it's obvious auth
# isn't configured yet rather than looking like a bad token.
SUPABASE_URL=https://ptjwcliszbfpknyryzft.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB0andjbGlzemJmcGtueXJ5emZ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk0NzA5NjcsImV4cCI6MjA4NTA0Njk2N30.xH-ENlljPRg3MjUQ4IcFmx3vM7pJHS4xPLn3wuho-1o
# Server only — never in the web app. Lets sign-up create a confirmed account
# (in straight away) and lets account deletion remove the Supabase user.
# Supabase -> Project Settings -> API -> service_role. See docs/auth-setup.md.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this API (one-click unsubscribe headers in emails).
PUBLIC_API_URL=
# Business details for email footers (fill in once incorporated).
BUSINESS_NAME=Warden
BUSINESS_ADDRESS=
CONTACT_EMAIL=

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Vault (Fase 5) ---
# Production should set a real Fernet.generate_key() value here. Left
# empty, app/vault.py derives one from APP_SECRET_KEY — fine for a
# laptop, wrong for anything holding real credentials.
VAULT_ENCRYPTION_KEY=

# --- Push notifications (ntfy) ---
NTFY_TOPIC=

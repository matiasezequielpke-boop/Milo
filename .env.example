# --- Model providers (leave empty until there's budget — Fase 0) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Tool providers (Fase 2/3 — same "leave empty until funded" rule) ---
TAVILY_API_KEY=
E2B_API_KEY=

# --- Database ---
# Local/docker-compose Postgres by default. For production, point this at
# Supabase's connection pooler instead — Project Settings -> Database ->
# Connection string -> "Transaction" pooler in the Supabase dashboard.
# The password there is the one set when the project was created (or reset
# from that same page) — it isn't retrievable any other way, including via
# the Supabase MCP tools, so this has to be filled in by hand:
#   postgresql://postgres.ptjwcliszbfpknyryzft:[DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://milo:milo@localhost:5432/milo

# --- Supabase Auth (identity — see claude/ruta-a-produccion.md) ---
# Both required for login to work at all; without them every authenticated
# endpoint returns 503, not 401 (see app/deps.py) so it's obvious auth
# isn't configured yet rather than looking like a bad token.
SUPABASE_URL=https://ptjwcliszbfpknyryzft.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB0andjbGlzemJmcGtueXJ5emZ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk0NzA5NjcsImV4cCI6MjA4NTA0Njk2N30.xH-ENlljPRg3MjUQ4IcFmx3vM7pJHS4xPLn3wuho-1o

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Vault (Fase 5) ---
# Production should set a real Fernet.generate_key() value here. Left
# empty, app/vault.py derives one from APP_SECRET_KEY — fine for a
# laptop, wrong for anything holding real credentials.
VAULT_ENCRYPTION_KEY=

# --- Push notifications (ntfy) ---
NTFY_TOPIC=
